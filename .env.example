# Copia este archivo como .env.local y completa los valores.
# .env.local no se versiona.

# --- Envío del formulario de contacto (Gmail) ---
# Cuenta de Gmail desde la que sale el correo.
GMAIL_USER=tucuenta@gmail.com

# Contraseña de aplicación de 16 caracteres, NO la contraseña de la cuenta.
# Se genera en https://myaccount.google.com/apppasswords (requiere verificación en dos pasos).
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Bandeja que recibe los leads del formulario.
GMAIL_TO=leads@escalania.com

# --- SEO ---
# URL pública del sitio, sin barra final. La usan sitemap.xml, robots.txt y Open Graph.
NEXT_PUBLIC_SITE_URL=https://escalania.com

# --- Analítica ---
# Identificador del conjunto de datos (píxel) de Meta. Vacío = no se carga el píxel.
NEXT_PUBLIC_META_PIXEL_ID=
